<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VrcftSdkDir Condition="'$(VrcftSdkDir)' == ''">$(MSBuildThisFileDirectory)../../.sdk</VrcftSdkDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../UnifiedPicoModule.csproj" />
    <Reference Include="VRCFaceTracking.SDK"><HintPath>$(VrcftSdkDir)/VRCFaceTracking.SDK.dll</HintPath></Reference>
    <Reference Include="VRCFaceTracking.Core"><HintPath>$(VrcftSdkDir)/VRCFaceTracking.Core.dll</HintPath></Reference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
  </ItemGroup>
</Project>
